# VISTA Environment Configuration Example

# Server & Database
PORT=8002
DATABASE_URL=sqlite:///./vista_dev.db

# LLM Study Coach Configuration
# Exactly one of LLM_USE_API or LLM_USE_OLLAMA should be true.
# If both are true or both false, VISTA safely uses the deterministic rule-based coach.
LLM_USE_API=true
LLM_USE_OLLAMA=false

# OpenRouter Configuration (when LLM_USE_API=true)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama Configuration (when LLM_USE_OLLAMA=true)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3

# Proactive Alerts (Switchable, off by default)
AUTO_ATTENDANCE_ALERTS_ENABLED=false
